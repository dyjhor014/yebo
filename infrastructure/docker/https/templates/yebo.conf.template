# Modo HTTPS local de YEBO (docs/development/https-local.md). Plantilla: la imagen oficial de Nginx sustituye
# ${YEBO_*} al arrancar; las variables propias de Nginx ($host...) no se tocan.
# Nginx publica <IP>:443 y reenvía a las apps del host, que solo escuchan en 127.0.0.1, por host.docker.internal.
# Con Docker Desktop esas conexiones llegan a la API desde loopback, así que TRUST_PROXY=loopback basta.
# Limitación: Nginx ve la IP de la pasarela de Docker, no la del cliente (los límites de intentos por IP se
# comparten entre todos los equipos de prueba).
server_tokens off;
client_max_body_size 10m;

upstream yebo_api { server host.docker.internal:4100; keepalive 16; }
upstream yebo_web { server host.docker.internal:3100; keepalive 16; }
upstream yebo_platform { server host.docker.internal:3101; keepalive 16; }

ssl_certificate /etc/nginx/certs/server.crt;
ssl_certificate_key /etc/nginx/certs/server.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:yebo:10m;

# Cualquier otro nombre (o la IP sola): no es una app de YEBO.
server {
  listen 443 ssl default_server;
  http2 on;
  default_type text/plain;
  return 404 "YEBO: entra por https://admin.${YEBO_BASE_DOMAIN} (panel) o https://cuentas.${YEBO_BASE_DOMAIN} (cuentas).\n";
}

# Panel del staff (PLATFORM_ADMIN_HOST).
server {
  listen 443 ssl;
  http2 on;
  server_name admin.${YEBO_BASE_DOMAIN};
  location /api/ { proxy_pass http://yebo_api; include /etc/nginx/snippets/yebo-proxy.conf; }
  location / { proxy_pass http://yebo_platform; include /etc/nginx/snippets/yebo-proxy.conf; }
}

# Hub de cuentas (AUTH_HUB_HOST) y empresas (<slug>.TENANT_BASE_DOMAIN): app web y API en el mismo origen.
server {
  listen 443 ssl;
  http2 on;
  server_name ~^[a-z0-9-]+\.${YEBO_BASE_DOMAIN_RE}$;
  location /api/ { proxy_pass http://yebo_api; include /etc/nginx/snippets/yebo-proxy.conf; }
  location / { proxy_pass http://yebo_web; include /etc/nginx/snippets/yebo-proxy.conf; }
}
