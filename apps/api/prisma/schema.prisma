// Esquema de producción de YEBO.
// Fase 2 (fundación técnica): todavía no hay modelos de negocio. Los modelos se incorporan
// a partir de la Fase 3 siguiendo docs/database/data-dictionary.md.
// Convenciones: tablas snake_case (@@map), UUID v7, tenant_id + UNIQUE(tenant_id, id),
// FK compuestas con tenant_id y RLS forzado en toda tabla de tenant (ADR-003).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Fase 3.1 · Plataforma: tenants y dominios (tablas globales 🌐, sin RLS de tenant)
// ============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED

  @@map("tenant_status")
}

enum TenantDomainKind {
  SUBDOMAIN
  CUSTOM

  @@map("tenant_domain_kind")
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED

  @@map("domain_verification_status")
}

/// 🌐 Empresa cliente. Su estado solo cambia por la máquina de estados (Fase 4).
model Tenant {
  id              String       @id @default(uuid(7)) @db.Uuid
  slug            String       @unique @db.Citext
  legalName       String       @map("legal_name")
  tradeName       String       @map("trade_name")
  taxIdType       String       @map("tax_id_type")
  taxId           String       @map("tax_id")
  fiscalAddress   String?      @map("fiscal_address")
  phones          Json         @default("[]")
  emails          Json         @default("[]")
  status          TenantStatus @default(TRIAL)
  timezone        String       @default("America/Lima")
  defaultCurrency String       @default("PEN") @map("default_currency") @db.Char(3)
  trialEndsAt     DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  activatedAt     DateTime?    @map("activated_at") @db.Timestamptz(6)
  cancelledAt     DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  domains            TenantDomain[]
  memberships        TenantMembership[]
  roles              Role[]
  tenantSessions     TenantSession[]
  authorizationCodes AuthorizationCode[]

  @@unique([taxIdType, taxId])
  @@map("tenants")
}

/// 🌐 Host → tenant. Solo los dominios VERIFIED resuelven un tenant (ADR-004).
model TenantDomain {
  id                 String                   @id @default(uuid(7)) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  host               String                   @unique @db.Citext
  kind               TenantDomainKind
  /// TRUE o NULL (CHECK en SQL): UNIQUE(tenant_id, is_primary) garantiza un único dominio principal.
  isPrimary          Boolean?                 @map("is_primary")
  verificationStatus DomainVerificationStatus @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, isPrimary])
  @@index([tenantId])
  @@map("tenant_domains")
}

// ============================================================================
// Fase 3.1 · Identidad y acceso (D3: identidad global + membresías por tenant)
// ============================================================================

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED

  @@map("user_status")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED

  @@map("membership_status")
}

enum MembershipKind {
  HUMAN

  @@map("membership_kind")
}

/// 🌐 Identidad global: solo los datos necesarios para autenticar. yebo_app no tiene acceso.
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique @db.Citext
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime   @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships      TenantMembership[]
  identitySessions IdentitySession[]
  tenantSessions   TenantSession[]

  @@map("users")
}

/// Membresía del usuario en una empresa. Roles y permisos cuelgan de la membresía, no del usuario.
model TenantMembership {
  id                 String           @id @default(uuid(7)) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  status             MembershipStatus @default(INVITED)
  kind               MembershipKind   @default(HUMAN)
  /// Solo modificable por la plataforma (D5).
  billable           Boolean          @default(true)
  displayName        String?          @map("display_name")
  /// Se incrementa al cambiar roles o permisos: invalida tokens con otra versión (`ver`).
  permissionsVersion Int              @default(1) @map("permissions_version")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roles          MembershipRole[]
  tenantSessions TenantSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  /// Destino de la FK compuesta de tenant_sessions: la membresía es de ese usuario y de ese tenant.
  @@unique([tenantId, userId, id])
  @@index([userId])
  @@map("tenant_memberships")
}

/// 🌐 Catálogo global de permisos (`shipments.deliver`, `customers.pii.read`…).
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  moduleCode  String   @map("module_code")
  description String
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// 🌐 Plantillas de rol de la plataforma (Administrador, Cajero, Almacenero…).
model RoleTemplate {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique
  name            String
  permissionCodes String[] @map("permission_codes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roles Role[]

  @@map("role_templates")
}

/// Rol de un tenant, creado desde una plantilla o propio.
model Role {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  templateId String?   @map("template_id") @db.Uuid
  isSystem   Boolean   @default(false) @map("is_system")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  template    RoleTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// FK compuesta: el rol debe pertenecer al MISMO tenant.
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// FK compuestas: membresía y rol deben pertenecer al MISMO tenant.
  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade, onUpdate: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, membershipId, roleId])
  @@index([tenantId, roleId])
  @@map("membership_roles")
}

// ============================================================================
// Fase 3.2 · Sesiones (ADR-009, ADR-022; identity-and-sessions §6–8, §11)
// Tablas globales gestionadas por identidad con yebo_platform. yebo_app no tiene acceso.
// ============================================================================

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  MEMBERSHIP_REVOKED
  ADMIN_REVOKED
  REFRESH_REUSE
  USER_DISABLED
  /// Fase 3.2b: se canjeó de nuevo un código de autorización ya usado (RFC 6749 §4.1.2).
  AUTH_CODE_REUSE

  @@map("session_revoke_reason")
}

/// 🌐 Sesión de identidad del hub de cuentas (cookie __Host-yebo_hub). No da acceso a datos de ninguna empresa.
/// Tablas de sesión: solo el rol dedicado yebo_identity (Fase 3.2a); ni yebo_app ni yebo_platform.
model IdentitySession {
  id                String               @id @default(uuid(7)) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  ip                String?              @db.Inet
  userAgent         String?              @map("user_agent")
  authMethods       String[]             @map("auth_methods")
  mfaVerifiedAt     DateTime?            @map("mfa_verified_at") @db.Timestamptz(6)
  lastSeenAt        DateTime             @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime             @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason      SessionRevokeReason? @map("revoke_reason")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenantSessions     TenantSession[]
  authorizationCodes AuthorizationCode[]

  /// Destino de la FK compuesta de tenant_sessions: la sesión hija es del mismo usuario.
  @@unique([id, userId])
  @@index([userId])
  @@map("identity_sessions")
}

/// 🌐 Sesión de UNA empresa en UN dominio, hija de una sesión de identidad. Excepción global con tenant_id:
/// se consulta para validar el token antes de abrir el contexto de tenant (multitenancy §4.3).
model TenantSession {
  id                String               @id @default(uuid(7)) @db.Uuid
  identitySessionId String               @map("identity_session_id") @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  membershipId      String               @map("membership_id") @db.Uuid
  host              String               @db.Citext
  lastSeenAt        DateTime             @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime             @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime             @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason      SessionRevokeReason? @map("revoke_reason")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  /// FK compuestas: la sesión de identidad es del mismo usuario, y la membresía es de ese usuario en ese tenant.
  identitySession    IdentitySession     @relation(fields: [identitySessionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership         TenantMembership    @relation(fields: [tenantId, userId, membershipId], references: [tenantId, userId, id], onDelete: Restrict, onUpdate: Restrict)
  refreshTokens      RefreshToken[]
  authorizationCodes AuthorizationCode[]

  @@index([identitySessionId])
  @@index([userId])
  @@index([tenantId, membershipId])
  @@map("tenant_sessions")
}

/// 🌐 Refresh token opaco (solo el SHA-256). Familia = sesión de empresa. Rotación con ventana de gracia.
/// El sucesor se obtiene por parent_id: UNIQUE(tenant_session_id, parent_id) garantiza un único sucesor.
model RefreshToken {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantSessionId     String    @map("tenant_session_id") @db.Uuid
  tokenHash           Bytes     @unique @map("token_hash")
  parentId            String?   @map("parent_id") @db.Uuid
  rotatedAt           DateTime? @map("rotated_at") @db.Timestamptz(6)
  /// Sucesor cifrado (AES-256-GCM, clave HKDF del token padre en claro, que nunca se guarda). Solo se usa
  /// dentro de la ventana de gracia para devolver el MISMO sucesor; sin el token padre no se puede descifrar.
  successorCiphertext Bytes?    @map("successor_ciphertext")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenantSession TenantSession @relation(fields: [tenantSessionId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  parent        RefreshToken? @relation("RefreshTokenRotation", fields: [tenantSessionId, parentId], references: [tenantSessionId, id], onDelete: Restrict, onUpdate: Restrict)
  successor     RefreshToken? @relation("RefreshTokenRotation")

  /// Destino de la FK compuesta del sucesor: la cadena de rotación no cruza sesiones.
  @@unique([tenantSessionId, id])
  /// Un token tiene como máximo un sucesor.
  @@unique([tenantSessionId, parentId])
  @@map("refresh_tokens")
}

// ============================================================================
// Fase 3.2b · Códigos de autorización del hub (OAuth 2.0 Authorization Code + PKCE S256; ADR-022)
// ============================================================================

/// 🌐 Código de un solo uso emitido por el hub. Solo se guarda su SHA-256. Ligado al tenant, al redirect_uri
/// derivado del dominio verificado, al host que lo canjea y a la sesión de identidad. Excepción global con
/// tenant_id (se canjea antes de que exista la sesión de empresa). Solo yebo_identity.
model AuthorizationCode {
  id                  String    @id @default(uuid(7)) @db.Uuid
  codeHash            Bytes     @unique @map("code_hash")
  userId              String    @map("user_id") @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  identitySessionId   String    @map("identity_session_id") @db.Uuid
  redirectUri         String    @map("redirect_uri")
  redemptionHost      String    @map("redemption_host") @db.Citext
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime? @map("consumed_at") @db.Timestamptz(6)
  /// Sesión emitida al canjearlo: se revoca si el código se presenta de nuevo (RFC 6749 §4.1.2).
  tenantSessionId     String?   @map("tenant_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  identitySession IdentitySession @relation(fields: [identitySessionId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenantSession   TenantSession?  @relation(fields: [tenantSessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([identitySessionId])
  @@index([tenantSessionId])
  @@map("authorization_codes")
}

// ============================================================================
// Fase 4.1 · Staff de YEBO (realm de plataforma, separado de la identidad de clientes). Tablas globales 🌐,
// exclusivas del rol yebo_backoffice (ADR-034, decisión F4-Q2). Nadie más tiene acceso.
// ============================================================================

enum PlatformRole {
  /// Todo, incluida la gestión del staff.
  SUPERADMIN
  /// Planes, suscripciones, períodos, facturas y pagos; lectura de empresas.
  BILLING
  /// Lectura de empresas y accesos de soporte (4.6).
  SUPPORT
  /// Solo lectura.
  VIEWER

  @@map("platform_role")
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED

  @@map("platform_user_status")
}

enum PlatformSessionRevokeReason {
  LOGOUT
  USER_DISABLED
  ADMIN_REVOKED

  @@map("platform_session_revoke_reason")
}

model PlatformUser {
  id                  String             @id @default(uuid(7)) @db.Uuid
  email               String             @unique @db.Citext
  fullName            String             @map("full_name")
  /// Nulo hasta que la persona fija su contraseña con el enlace de configuración.
  passwordHash        String?            @map("password_hash")
  role                PlatformRole
  status              PlatformUserStatus @default(ACTIVE)
  /// Secreto TOTP cifrado (ADR-019: AES-256-GCM, IV + etiqueta incluidos) y versión de la clave.
  mfaSecretCiphertext Bytes?             @map("mfa_secret_ciphertext")
  mfaKeyVersion       Int?               @map("mfa_key_version")
  mfaEnabledAt        DateTime?          @map("mfa_enabled_at") @db.Timestamptz(6)
  /// Último paso TOTP aceptado: un código no puede reutilizarse (RFC 6238 §5.2).
  mfaLastStep         BigInt?            @map("mfa_last_step")
  passwordChangedAt   DateTime?          @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?          @map("last_login_at") @db.Timestamptz(6)
  createdById         String?            @map("created_by_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy    PlatformUser?        @relation("PlatformUserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  created      PlatformUser[]       @relation("PlatformUserCreatedBy")
  sessions     PlatformSession[]
  setupTokens  PlatformSetupToken[] @relation("SetupTokenFor")
  issuedTokens PlatformSetupToken[] @relation("SetupTokenIssuedBy")
  auditEntries PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformSession {
  id                String                       @id @default(uuid(7)) @db.Uuid
  platformUserId    String                       @map("platform_user_id") @db.Uuid
  /// SHA-256 del token opaco de la cookie. El token nunca se guarda.
  tokenHash         Bytes                        @unique @map("token_hash")
  ip                String?                      @db.Inet
  userAgent         String?                      @map("user_agent")
  lastSeenAt        DateTime                     @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt     DateTime                     @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime                     @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?                    @map("revoked_at") @db.Timestamptz(6)
  revokeReason      PlatformSessionRevokeReason? @map("revoke_reason")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformUserId])
  @@map("platform_sessions")
}

/// Enlace de un solo uso para que un miembro del staff fije su contraseña (alta o restablecimiento).
model PlatformSetupToken {
  id             String    @id @default(uuid(7)) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tokenHash      Bytes     @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  issuedById     String?   @map("issued_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser  @relation("SetupTokenFor", fields: [platformUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy     PlatformUser? @relation("SetupTokenIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformUserId])
  @@map("platform_setup_tokens")
}

/// Auditoría de las acciones del staff (append-only: el rol de ejecución solo puede insertar y leer).
model PlatformAuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  platformUserId String?  @map("platform_user_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  tenantId       String?  @map("tenant_id") @db.Uuid
  detail         Json     @default("{}")
  ip             String?  @db.Inet
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformUserId, occurredAt])
  @@index([tenantId, occurredAt])
  @@map("platform_audit_logs")
}
