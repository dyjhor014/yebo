# Plantilla de configuración de la API y el worker.
# En desarrollo, scripts/dev/init-env.sh genera apps/api/.env con contraseñas aleatorias.
# En producción, las variables se inyectan en el despliegue: nunca se versiona un .env real.

NODE_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=4100
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4101
LOG_LEVEL=info
LOG_PRETTY=true
# Valor de Express "trust proxy". En producción, la IP o subred de Nginx.
TRUST_PROXY=loopback
SWAGGER_ENABLED=true

# PostgreSQL (ADR-003: tres roles con privilegios distintos)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=yebo_dev
PG_POOL_MAX=10
# Espera máxima (ms) para obtener conexión al iniciar una transacción; agotada → 503 con Retry-After.
PG_TX_MAX_WAIT_MS=10000
PG_APP_USER=yebo_app
PG_APP_PASSWORD=change-me
PG_PLATFORM_USER=yebo_platform
PG_PLATFORM_PASSWORD=change-me
# Rol dedicado del módulo identity (sesiones y tokens). Solo lo usa la API.
PG_IDENTITY_USER=yebo_identity
PG_IDENTITY_PASSWORD=change-me
# Rol del superadmin (Fase 4, F4-Q2): tablas de plataforma con permisos explícitos. Solo lo usa la API de plataforma.
PG_BACKOFFICE_USER=yebo_backoffice
PG_BACKOFFICE_PASSWORD=change-me
# Rol de la medición (Fase 4.4, F4-Q2): historial y snapshots con el contexto de cada tenant. Solo el worker.
PG_METERING_USER=yebo_metering
PG_METERING_PASSWORD=change-me
# Solo lo usan las migraciones (Prisma CLI). La API en ejecución nunca lo necesita.
PG_OWNER_USER=yebo_owner
PG_OWNER_PASSWORD=change-me
PG_SHADOW_DATABASE=yebo_shadow

# Redis (colas BullMQ, caché, rate limit)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=change-me
BULLMQ_PREFIX=yebo

# Autenticación (security.md §1). scripts/dev/init-env.sh genera la clave en desarrollo.
# Clave privada Ed25519 en PEM PKCS#8 codificado en base64 (una línea). Nunca se versiona una clave real.
AUTH_JWT_PRIVATE_KEY=change-me
AUTH_JWT_KEY_ID=k1
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=[]
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_GRACE_SECONDS=20
AUTH_SESSION_IDLE_MINUTES=720
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_JWT_AUDIENCE=yebo-tenant-api
# Hub de cuentas (host) y clave HMAC de las cookies del flujo de login (≥ 32 caracteres; la genera init-env.sh).
AUTH_HUB_HOST=cuentas.yebo.pe
AUTH_COOKIE_SECRET=change-me
# Argon2id (mínimos OWASP). Recalibrar con: pnpm --filter @yebo/api calibrate:argon2
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENT=4
ARGON2_MAX_QUEUE=64

# Panel de administración de YEBO (Fase 4.1): host propio, sesión del staff y MFA obligatoria.
PLATFORM_ADMIN_HOST=admin.yebo.pe
# Dominio base de los tenants (Fase 4.3): subdominio por defecto <slug>.<dominio>. El hub y el panel son subdominios suyos.
TENANT_BASE_DOMAIN=yebo.pe
PLATFORM_SESSION_IDLE_MINUTES=30
PLATFORM_SESSION_ABSOLUTE_HOURS=12
# Cifrado de campo (ADR-019): AES-256-GCM. Clave de 32 bytes en base64 (la genera init-env.sh) y su versión.
FIELD_ENCRYPTION_KEY=change-me
FIELD_ENCRYPTION_KEY_VERSION=1
