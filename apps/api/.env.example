# Plantilla de configuración de la API y el worker.
# En desarrollo, scripts/dev/init-env.sh genera apps/api/.env con contraseñas aleatorias.
# En producción, las variables se inyectan en el despliegue: nunca se versiona un .env real.

NODE_ENV=development
APP_VERSION=0.1.0
API_HOST=127.0.0.1
API_PORT=4100
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4101
LOG_LEVEL=info
LOG_PRETTY=true
# Valor de Express "trust proxy". En producción, la IP o subred de Nginx.
TRUST_PROXY=loopback
SWAGGER_ENABLED=true

# PostgreSQL (ADR-003: tres roles con privilegios distintos)
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=yebo_dev
PG_POOL_MAX=10
PG_APP_USER=yebo_app
PG_APP_PASSWORD=change-me
PG_PLATFORM_USER=yebo_platform
PG_PLATFORM_PASSWORD=change-me
# Solo lo usan las migraciones (Prisma CLI). La API en ejecución nunca lo necesita.
PG_OWNER_USER=yebo_owner
PG_OWNER_PASSWORD=change-me
PG_SHADOW_DATABASE=yebo_shadow

# Redis (colas BullMQ, caché, rate limit)
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=change-me
BULLMQ_PREFIX=yebo
