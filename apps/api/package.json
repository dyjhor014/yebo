{
  "name": "@yebo/api",
  "version": "0.1.0",
  "private": true,
  "description": "API y worker de YEBO (NestJS, monolito modular — ADR-001)",
  "scripts": {
    "generate": "prisma generate && prisma generate --config test/poc/tenancy/prisma.config.ts && prisma generate --config test/poc/inventory/prisma.config.ts",
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "calibrate:argon2": "node scripts/calibrate-argon2.mjs",
    "bench": "jest -c jest.bench.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@yebo/contracts": "workspace:*",
    "bullmq": "5.81.5",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-cls": "6.3.1",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "@yebo/config": "workspace:*",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  }
}
